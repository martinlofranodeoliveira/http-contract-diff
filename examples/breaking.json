{
  "version": 1,
  "routes": [
    {
      "method": "GET",
      "path": "/catalog",
      "request": {"fields": {"category": {"type": "string", "required": true, "enum": ["books"]}}},
      "responses": {"200": {"fields": {"id": {"type": "string", "required": false}, "state": {"type": "string", "required": true, "enum": ["active", "archived"]}}}}
    }
  ]
}
